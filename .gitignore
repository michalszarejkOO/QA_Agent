# Symlink to ~/.claude/environments/ (or wherever setup.sh's target points) —
# contains real staging credentials for various products (basic auth, test login
# IDs) — never commit. See environments.example/ for the documented shape.
environments

# Playwright MCP session artifacts (screenshots/traces) from running qa-tester —
# local debugging output, not part of the project.
.playwright-mcp/

# claude plugin eval run output (HTML/JSON reports) — regenerated per run, not
# part of the project.
evals/results/

# Generated client-facing reports (create-quality-metrics HTML output, named
# per its own convention: <project>-quality-<scope>.html) — regenerated per
# run from live Jira/test data, not part of the project.
*-quality-*.html

# testing-apps / testing-api fallback output folders when a run matches no
# product config with a 'workDir', plus Playwright MCP videos waiting to
# be moved into the run folder.
qa-evidence/
qa-video/
api-runs/

# OS cruft
.DS_Store
# Local claude settings
.claude/settings.local.json
# Python bytecode from running the repo scripts.
__pycache__/
